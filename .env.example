# 复制本文件为 .env 并填入真实值（.env 不会提交到 git）
# 运行环境: sit / uat / prod
ENV=uat

# 敏感账号信息
TEST_USERNAME=your_username
TEST_PASSWORD=your_password

# API Token (如有)
API_TOKEN=

# 数据库账号 (host/port/name 在 config.yaml)
DB_USER=
DB_PASSWORD=

# Redis 密码 (host/port/db 在 config.yaml)
REDIS_PASSWORD=

# 通知机器人 webhook (含密钥)
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=
