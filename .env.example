# 复制本文件为 .env 并填入真实值（.env 不会提交到 git）
# 运行环境: sit / uat / prod
ENV=uat

# 敏感账号信息
TEST_USERNAME=your_username
TEST_PASSWORD=your_password

# BOSS Web 自动化：地址和默认登录态路径按 ENV 从 config/config.yaml 读取
# 仅需覆盖默认路径时再填写；不同环境不要共用同一个登录态文件
BOSS_STORAGE_STATE=

# Android App 自动化（安装包和本机工具路径不要写入 config.yaml）
# 模拟器使用 APPIUM_AVD；真机使用 APPIUM_UDID。设置真机时框架会忽略 YAML 中的 avd。
APP_PATH=C:\path\to\your-app.apk
APPIUM_AVD=Pixel_6_API_34
APPIUM_UDID=
APP_PACKAGE=
APP_ACTIVITY=
APPIUM_PLATFORM_VERSION=14
APPIUM_SERVER=http://127.0.0.1:4723
APPIUM_MANAGE_SERVER=true
# 首次安装后若旧终端尚未读取系统变量，可在本地 .env 临时填写下面两项。
ANDROID_HOME=C:\Users\your_name\AppData\Local\Android\Sdk
JAVA_HOME=C:\Users\your_name\AppData\Local\Programs\Microsoft\OpenJDK\jdk-21

# API Token (如有)
API_TOKEN=

# 数据库账号 (host/port/name 在 config.yaml)
DB_USER=
DB_PASSWORD=

# Redis 密码 (host/port/db 在 config.yaml)
REDIS_PASSWORD=

# 通知机器人 webhook (含密钥)
DINGTALK_WEBHOOK=
DINGTALK_SECRET=          # 钉钉"加签"安全设置的密钥(SEC开头)；用关键词模式则留空
WECOM_WEBHOOK=

# 邮件 SMTP (发送测试报告)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=              # 收件人，多个用逗号分隔

# 测试跑完自动推送(CI 里设为 1)；报告地址
NOTIFY_ON_FINISH=
REPORT_URL=
